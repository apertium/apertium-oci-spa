<?xml version="1.0" encoding="UTF-8"?>
<modes>
  <!-- oci → spa -->
  <mode name="oci-spa" install="yes" gendebug="yes">
    <pipeline>
      <program name="lt-proc -w">
        <file name="oci-spa.automorf.bin"/>
      </program>
      <program name="cg-proc -w" debug-suff="disamb">
        <file name="oci-spa.rlx.bin"/>
      </program>
      <program name="apertium-tagger -g $2">
        <file name="oci-spa.prob"/>
      </program>
      <program name="apertium-pretransfer"/>
      <program name="lt-proc -b">
        <file name="oci-spa.autobil.bin"/>
      </program>
      <program name="lrx-proc -m">
        <file name="oci-spa.autolex.bin"/>
      </program>
      <program name="apertium-transfer -b">
        <file name="apertium-oci-spa.oci-spa.t1x"/>
        <file name="oci-spa.t1x.bin"/>
      </program>
      <program name="apertium-interchunk">
        <file name="apertium-oci-spa.oci-spa.t2x"/>
        <file name="oci-spa.t2x.bin"/>
      </program>
      <program name="apertium-postchunk">
        <file name="apertium-oci-spa.oci-spa.t3x"/>
        <file name="oci-spa.t3x.bin"/>
      </program>
      <program name="lt-proc $1">
        <file name="oci-spa.autogen.bin"/>
      </program>
      <program name="lt-proc -p">
        <file name="oci-spa.autopgen.bin"/>
      </program>
    </pipeline>
  </mode>

  <mode name="oci-spa-disam" install="no">
    <pipeline>
      <program name="lt-proc -w">
        <file name="oci-spa.automorf.bin"/>
      </program>
      <program name="cg-conv -a"/>
      <program name="vislcg3 --trace --grammar">
        <file name="oci-spa.rlx.bin"/>
      </program>
    </pipeline>
  </mode>

